{
  "manifest_version": 3,
  "name": "CarGurus Comps for Inventory Plus",
  "version": "0.9.3",
  "description": "Appraising a car in Inventory Plus? One click pulls matching CarGurus comps (same Y/M/M/trim, +/-mileage, within radius) with market value and Good/Great deal pricing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.cargurus.com/*",
    "https://*.dealersocket.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CarGurus Comps (open panel)"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.cargurus.com/*"
      ],
      "js": [
        "cargurus-makes.js",
        "content-cargurus.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
